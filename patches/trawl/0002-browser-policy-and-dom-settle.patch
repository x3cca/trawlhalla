diff --git a/packages/tiers/src/utils/browserPolicy.ts b/packages/tiers/src/utils/browserPolicy.ts
new file mode 100644
index 0000000..6db0bf7
--- /dev/null
+++ b/packages/tiers/src/utils/browserPolicy.ts
@@ -0,0 +1,53 @@
+import { readFileSync } from "node:fs"
+
+interface BrowserPolicy {
+  schemaVersion: 1
+  patterns: string[]
+}
+
+const MATCH_PATTERN = /^(\*|https?|file|ftp):\/\/([^/]+)(\/.*)$/
+
+function loadPatterns(): string[] {
+  const policyPath = process.env.TRAWL_FORCE_BROWSER_PATTERNS_FILE
+  if (!policyPath) return []
+  const policy = JSON.parse(readFileSync(policyPath, "utf8")) as BrowserPolicy
+  if (
+    policy.schemaVersion !== 1 ||
+    !Array.isArray(policy.patterns) ||
+    policy.patterns.some((item) => typeof item !== "string")
+  ) {
+    throw new Error(`Invalid browser policy file: ${policyPath}`)
+  }
+  return policy.patterns
+}
+
+const patterns = loadPatterns()
+
+function matchesPattern(pattern: string, rawUrl: string): boolean {
+  if (pattern === "<all_urls>") return /^(https?|file|ftp):/.test(rawUrl)
+  const match = MATCH_PATTERN.exec(pattern)
+  if (!match) return false
+  let url: URL
+  try {
+    url = new URL(rawUrl)
+  } catch {
+    return false
+  }
+  const [, scheme, hostPattern, pathPattern] = match
+  if (scheme !== "*" && url.protocol !== `${scheme}:`) return false
+  if (scheme === "*" && url.protocol !== "http:" && url.protocol !== "https:") return false
+  const hostname = url.hostname.toLowerCase()
+  const wantedHost = hostPattern.toLowerCase()
+  if (wantedHost.startsWith("*.")) {
+    const root = wantedHost.slice(2)
+    if (hostname !== root && !hostname.endsWith(`.${root}`)) return false
+  } else if (wantedHost !== "*" && hostname !== wantedHost) {
+    return false
+  }
+  const escaped = pathPattern.replace(/[.+?^${}()|[\]\\]/g, "\\$&").replaceAll("*", ".*")
+  return new RegExp(`^${escaped}$`).test(`${url.pathname}${url.search}`)
+}
+
+export function shouldForceBrowser(url: string): boolean {
+  return patterns.some((pattern) => matchesPattern(pattern, url))
+}
diff --git a/packages/tiers/src/utils/domSettle.ts b/packages/tiers/src/utils/domSettle.ts
new file mode 100644
index 0000000..7ad5ea2
--- /dev/null
+++ b/packages/tiers/src/utils/domSettle.ts
@@ -0,0 +1,61 @@
+// Wait for extension/content-script mutations to stop before serializing the DOM.
+// Disabled unless TRAWL_DOM_SETTLE_MAX_MS is greater than zero.
+// biome-ignore lint/suspicious/noExplicitAny: camoufox-js does not export its Page type
+export async function waitForDomSettle(page: any, budgetMs: number): Promise<void> {
+  const configuredMax = Number(process.env.TRAWL_DOM_SETTLE_MAX_MS ?? 0)
+  if (!Number.isFinite(configuredMax) || configuredMax <= 0 || budgetMs <= 0) return
+
+  const maxMs = Math.max(0, Math.min(configuredMax, budgetMs))
+  const minMs = Math.max(0, Number(process.env.TRAWL_DOM_SETTLE_MIN_MS ?? 1_000))
+  const stableMs = Math.max(0, Number(process.env.TRAWL_DOM_SETTLE_STABLE_MS ?? 750))
+  const pollMs = Math.max(50, Number(process.env.TRAWL_DOM_SETTLE_POLL_MS ?? 250))
+  const started = Date.now()
+  let stableSince = started
+  let previous = ""
+
+  while (Date.now() - started < maxMs) {
+    const signature = await page
+      .evaluate(() => {
+        type MutationState = { observer: MutationObserver; version: number }
+        const stateWindow = window as typeof window & { __trawlMutationState?: MutationState }
+        if (!stateWindow.__trawlMutationState) {
+          const state: MutationState = {
+            version: 0,
+            observer: new MutationObserver(() => {
+              state.version++
+            }),
+          }
+          if (document.documentElement) {
+            state.observer.observe(document.documentElement, {
+              attributes: true,
+              childList: true,
+              subtree: true,
+            })
+          }
+          stateWindow.__trawlMutationState = state
+        }
+        return `${stateWindow.__trawlMutationState.version}:${document.documentElement?.outerHTML.length ?? 0}`
+      })
+      .catch(() => "")
+
+    if (signature !== previous) {
+      previous = signature
+      stableSince = Date.now()
+    }
+    const elapsed = Date.now() - started
+    if (elapsed >= minMs && Date.now() - stableSince >= stableMs) break
+    await new Promise((resolve) =>
+      setTimeout(resolve, Math.min(pollMs, Math.max(0, maxMs - elapsed))),
+    )
+  }
+
+  await page
+    .evaluate(() => {
+      const stateWindow = window as typeof window & {
+        __trawlMutationState?: { observer: MutationObserver }
+      }
+      stateWindow.__trawlMutationState?.observer.disconnect()
+      delete stateWindow.__trawlMutationState
+    })
+    .catch(() => {})
+}
