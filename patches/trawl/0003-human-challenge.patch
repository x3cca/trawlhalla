+// HUMAN Bot Defender (formerly PerimeterX) block page. The /tosv2.html path,
+// px-captcha mount, and captcha.px-cdn.net loader are stable challenge signals.
+// Keep the checks conjunctive so a normal page mentioning HUMAN or loading
+// unrelated scripts is not classified as a wall.
+export function hasHumanChallenge(html: string, headers: Record<string, string> = {}): boolean {
+  const hasPxBlockHeader = Object.keys(headers).some((name) => /^x-px-(?:block|captcha|challenge)/i.test(name))
+  if (hasPxBlockHeader) return true
+
+  const hasCaptchaMount = /<px-captcha\b|(?:id|class)=["'][^"']*px-captcha/i.test(html)
+  const hasCaptchaHost = /captcha\.px-(?:cdn|cloud)\.net/i.test(html)
+  const hasRobotTitle = /<title[^>]*>[^<]*(?:are you a robot|unusual activity)[^<]*<\/title>/i.test(html)
+  const hasToSPage = /(?:^|[\/"'])tosv2\.html(?:[?#\/"']|$)/i.test(html)
+  const hasAppSignal = /_pxAppId|press[\s&-]+hold/i.test(html)
+
+  return (
+    (hasToSPage && (hasCaptchaHost || hasCaptchaMount || hasRobotTitle)) ||
+    (hasCaptchaMount && (hasCaptchaHost || hasRobotTitle || hasAppSignal))
+  )
+}
