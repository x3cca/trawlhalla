diff --git a/packages/tiers/src/utils/humanWait.ts b/packages/tiers/src/utils/humanWait.ts
new file mode 100644
index 0000000..61f09bf
--- /dev/null
+++ b/packages/tiers/src/utils/humanWait.ts
@@ -0,0 +1,112 @@
+import type { Page } from "patchright"
+import { hasHumanChallenge } from "./detect"
+
+const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms))
+
+const hostnameFor = (url?: string) => {
+  try {
+    return url ? new URL(url).hostname : ""
+  } catch {
+    return ""
+  }
+}
+
+export async function waitForHumanResolution(
+  page: Page,
+  timeoutMs: number,
+  originalUrl?: string,
+): Promise<"ok" | "ip-blocked" | "timeout"> {
+  const deadline = Date.now() + Math.max(timeoutMs, 0)
+  if (Date.now() >= deadline) return "timeout"
+
+  const targetHost = hostnameFor(originalUrl ?? page.url())
+  let challengeSeen = false
+  let heldOnce = false
+  let trustCookieAt: number | undefined
+
+  await sleep(Math.min(300, Math.max(deadline - Date.now(), 0)))
+
+  while (Date.now() < deadline) {
+    const html = await page.content().catch(() => "")
+    const url = page.url()
+    const active = hasHumanChallenge(html) || /\/tosv2\.html(?:[?#]|$)/i.test(url)
+
+    if (!active) {
+      if (challengeSeen) await page.waitForLoadState("load", { timeout: 5000 }).catch(() => {})
+      return "ok"
+    }
+    challengeSeen = true
+
+    if (!heldOnce && deadline - Date.now() > 5_500) heldOnce = await pressAndHold(page, deadline)
+
+    if (await hasTrustCookie(page, targetHost)) {
+      if (trustCookieAt === undefined) trustCookieAt = Date.now()
+      if (originalUrl && Date.now() - trustCookieAt > 2_000) {
+        await page.goto(originalUrl, { waitUntil: "domcontentloaded", timeout: 15_000 }).catch(() => {})
+        await page.waitForLoadState("load", { timeout: 5_000 }).catch(() => {})
+        const resolved = await page.content().catch(() => "")
+        return resolved && !hasHumanChallenge(resolved) && !/\/tosv2\.html(?:[?#]|$)/i.test(page.url())
+          ? "ok"
+          : "ip-blocked"
+      }
+    }
+
+    await sleep(Math.min(350, Math.max(deadline - Date.now(), 0)))
+  }
+
+  return "timeout"
+}
+
+async function hasTrustCookie(page: Page, targetHost: string): Promise<boolean> {
+  if (!targetHost) return false
+  const cookies: Array<{ name: string; domain: string }> = await page
+    .context()
+    .cookies()
+    .catch(() => [])
+  return cookies.some(
+    (cookie) =>
+      /^(?:_px2|_px3)$/i.test(cookie.name) &&
+      (cookie.domain === targetHost ||
+        cookie.domain === `.${targetHost}` ||
+        targetHost.endsWith(cookie.domain.replace(/^\./, ""))),
+  )
+}
+
+async function pressAndHold(page: Page, deadline: number): Promise<boolean> {
+  const selectors = [
+    "#px-captcha button",
+    "#px-captcha [role='button']",
+    ".px-captcha-container button",
+    ".px-captcha-container [role='button']",
+    "#px-captcha",
+    ".px-captcha-container",
+  ]
+  let mouseDown = false
+  try {
+    for (const selector of selectors) {
+      if (Date.now() >= deadline) return false
+      const element = page.locator(selector).first()
+      if (!(await element.isVisible({ timeout: 400 }).catch(() => false))) continue
+      const box = await element.boundingBox().catch(() => undefined)
+      if (!box || box.width < 4 || box.height < 4) continue
+      const cx = box.x + box.width / 2
+      const cy = box.y + box.height / 2
+      await page.mouse.move(Math.max(2, cx - 18), Math.max(2, cy - 10), { steps: 6 })
+      await page.mouse.move(cx, cy, { steps: 8 })
+      await page.mouse.down()
+      mouseDown = true
+      const holdUntil = Math.min(deadline, Date.now() + 5_000)
+      while (Date.now() < holdUntil) {
+        await page.mouse.move(cx + (Math.random() - 0.5) * 3, cy + (Math.random() - 0.5) * 3, { steps: 2 })
+        await sleep(Math.min(220, Math.max(holdUntil - Date.now(), 0)))
+      }
+      console.log("[human] press-and-hold performed")
+      return true
+    }
+  } catch {
+    return false
+  } finally {
+    if (mouseDown) await page.mouse.up().catch(() => {})
+  }
+  return false
+}
